<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.TTBS-HRMS" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorPrimaryDark">@color/brand_dark</item>
        <item name="colorAccent">@color/brand</item>
        <item name="android:statusBarColor">@color/brand_dark</item>
    </style>

    <style name="Theme.TTBS-HRMS.Check" parent="Theme.TTBS-HRMS">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>

    <style name="Theme.TTBS-HRMS.Alarm" parent="Theme.TTBS-HRMS">
        <item name="android:windowBackground">@color/danger</item>
        <item name="android:statusBarColor">@color/danger</item>
        <item name="android:navigationBarColor">@color/danger</item>
    </style>

    <style name="Label" parent="android:Widget.TextView">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:layout_marginTop">14dp</item>
    </style>

    <style name="Section" parent="android:Widget.TextView">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:layout_marginTop">22dp</item>
        <item name="android:layout_marginBottom">4dp</item>
    </style>
</resources>
