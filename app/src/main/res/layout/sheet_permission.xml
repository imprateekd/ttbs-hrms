<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#0D1C33"
    android:orientation="vertical"
    android:padding="18dp">

    <View
        android:layout_width="34dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="#2A3F60" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="One more step"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="TTBS-HRMS needs accessibility to sign you in and read your punch times."
        android:textColor="#9FB6D8"
        android:textSize="12sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:lineSpacingExtra="4dp"
        android:text="1.  Open Settings → Accessibility\n2.  Installed apps → TTBS-HRMS\n3.  Turn it on and allow"
        android:textColor="#B9CBEA"
        android:textSize="12sp" />

    <Button
        android:id="@+id/btnOpenSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:backgroundTint="#2F7DFF"
        android:text="Open accessibility settings"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="13sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnNotNow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:backgroundTint="#1B2C46"
        android:text="Not now"
        android:textAllCaps="false"
        android:textColor="#CFE0FF"
        android:textSize="13sp" />
</LinearLayout>
