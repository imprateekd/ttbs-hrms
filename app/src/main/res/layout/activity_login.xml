<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#08132A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="13dp"
        android:paddingTop="8dp"
        android:paddingEnd="13dp"
        android:paddingBottom="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/btnSettings"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:background="@drawable/bg_strip"
                android:contentDescription="Settings"
                android:padding="7dp"
                android:src="@drawable/ic_settings_cog" />
        </LinearLayout>

        <!-- LOGO ON TOP -->
        <ImageView
            android:layout_width="132dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="2dp"
            android:adjustViewBounds="true"
            android:contentDescription="Technotask"
            android:src="@drawable/logo_technotask" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="10dp"
            android:gravity="center"
            android:letterSpacing="0.22"
            android:text="EMPLOYEE PORTAL"
            android:textColor="#8FA6C8"
            android:textSize="7sp" />

        <!-- CARD 1: counters + break -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_card14"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:id="@+id/timerRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/selectableItemBackground"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.1"
                        android:text="PUNCH IN"
                        android:textColor="#7F93B3"
                        android:textSize="6sp" />

                    <TextView
                        android:id="@+id/tvPin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:letterSpacing="-0.02"
                        android:text="--:--"
                        android:textColor="#FFFFFF"
                        android:textSize="19sp" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="#1FFFFFFF" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:letterSpacing="0.1"
                        android:text="PUNCH OUT"
                        android:textColor="#7F93B3"
                        android:textSize="6sp" />

                    <TextView
                        android:id="@+id/tvPout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:text="--:--"
                        android:textColor="#FFFFFF"
                        android:textSize="19sp" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="#1FFFFFFF" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:id="@+id/dotActive"
                            android:layout_width="5dp"
                            android:layout_height="5dp"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/bg_dot_gold"
                            android:visibility="gone" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:letterSpacing="0.1"
                            android:text="ACTIVE"
                            android:textColor="#7F93B3"
                            android:textSize="6sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvActive"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="monospace"
                        android:letterSpacing="-0.02"
                        android:text="00:00:00"
                        android:textColor="#FFD66E"
                        android:textSize="19sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/breakFooter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:background="@drawable/bg_break_idle"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="10dp"
                android:paddingTop="9dp"
                android:paddingEnd="10dp"
                android:paddingBottom="9dp">

                <View
                    android:id="@+id/dotBreak"
                    android:layout_width="5dp"
                    android:layout_height="5dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_dot_amber"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/lblBreak"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.12"
                    android:text="BREAK"
                    android:textColor="#7F93B3"
                    android:textSize="5.5sp" />

                <TextView
                    android:id="@+id/tvBreak"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:fontFamily="monospace"
                    android:text="00:00:00 / 45m"
                    android:textColor="#B9CBEA"
                    android:textSize="11sp" />

                <Button
                    android:id="@+id/btnBreak"
                    android:layout_width="wrap_content"
                    android:layout_height="34dp"
                    android:backgroundTint="#FFB020"
                    android:minWidth="0dp"
                    android:paddingStart="15dp"
                    android:paddingEnd="15dp"
                    android:text="Start break"
                    android:textAllCaps="false"
                    android:textColor="#3A2600"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- CARD 2: the form -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card14"
            android:orientation="vertical"
            android:padding="11dp">

            <LinearLayout
                android:id="@+id/onboardCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_onboard"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="10dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Set your punch-out time so that you won't miss your punch-outs!"
                    android:textColor="#CFE0FF"
                    android:textSize="10sp" />

                <Button
                    android:id="@+id/btnOnboardSet"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:backgroundTint="#2F7DFF"
                    android:minWidth="0dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="Set"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/btnOnboardClose"
                    android:layout_width="30dp"
                    android:layout_height="32dp"
                    android:gravity="center"
                    android:text="✕"
                    android:textColor="#7F93B3"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.14"
                android:text="EMPLOYEE ID / USERNAME"
                android:textColor="#93B0DA"
                android:textSize="6.5sp" />

            <EditText
                android:id="@+id/etUser"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:background="@drawable/bg_input"
                android:hint="TTBS206217"
                android:inputType="text"
                android:padding="9dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#7F93B3"
                android:textSize="11sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:letterSpacing="0.14"
                android:text="PASSWORD"
                android:textColor="#93B0DA"
                android:textSize="6.5sp" />

            <EditText
                android:id="@+id/etPass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:layout_marginBottom="12dp"
                android:background="@drawable/bg_input"
                android:hint="••••••••"
                android:inputType="textPassword"
                android:padding="9dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#7F93B3"
                android:textSize="11sp" />

            <LinearLayout
                android:id="@+id/saveRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <CheckBox
                    android:id="@+id/cbSave"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:buttonTint="#4C8DFF"
                    android:checked="true" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Save these details on this phone (encrypted) so the app can fill your login"
                    android:textColor="#9FB6D8"
                    android:textSize="9.5sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnCheck"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_check_outline"
                android:text="Check Login Time"
                android:textAllCaps="false"
                android:textColor="#9FC4FF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnSignIn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:backgroundTint="#2F7DFF"
                android:paddingTop="12dp"
                android:paddingBottom="12dp"
                android:text="Sign In to Account"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvSig"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:letterSpacing="0.24"
            android:text=""
            android:textColor="#9FB6D8"
            android:textSize="8sp" />

        <View
            android:id="@+id/sigRule"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:background="#4C8DFF" />
    </LinearLayout>
</ScrollView>
