<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#08132A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="22dp">

        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="170dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:adjustViewBounds="true"
            android:contentDescription="Technotask"
            android:src="@drawable/logo_technotask" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="22dp"
            android:gravity="center"
            android:letterSpacing="0.22"
            android:text="EMPLOYEE PORTAL"
            android:textColor="#8FA6C8"
            android:textSize="9sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.14"
            android:text="EMPLOYEE ID / USERNAME"
            android:textColor="#93B0DA"
            android:textSize="8sp" />

        <EditText
            android:id="@+id/etUser"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="#14FFFFFF"
            android:hint="TTBS206217"
            android:inputType="text"
            android:padding="12dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#7F93B3"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:letterSpacing="0.14"
            android:text="PASSWORD"
            android:textColor="#93B0DA"
            android:textSize="8sp" />

        <EditText
            android:id="@+id/etPass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="#14FFFFFF"
            android:hint="••••••••"
            android:inputType="textPassword"
            android:padding="12dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#7F93B3"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/saveRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <CheckBox
                android:id="@+id/cbSave"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:buttonTint="#4C8DFF"
                android:checked="true" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Save these details on this phone (encrypted) so the app can fill your login"
                android:textColor="#9FB6D8"
                android:textSize="11sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnSignIn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:backgroundTint="#2F7DFF"
            android:paddingTop="14dp"
            android:paddingBottom="14dp"
            android:text="Sign In to Account"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSig"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="18dp"
            android:letterSpacing="0.24"
            android:text=""
            android:textColor="#9FB6D8"
            android:textSize="10sp" />

        <View
            android:id="@+id/sigRule"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:background="#4C8DFF" />

        <TextView
            android:id="@+id/tvReader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:background="#12FFFFFF"
            android:padding="12dp"
            android:textColor="#B9CBEA"
            android:textSize="11sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnReaderHelp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:backgroundTint="#173A66"
            android:text="How to enable the screen reader"
            android:textAllCaps="false"
            android:textColor="#DCE8FA"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
