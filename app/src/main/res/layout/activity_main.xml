<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#08132A"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:contentDescription="Back"
                android:padding="6dp"
                android:src="@drawable/ic_back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="Settings"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- TODAY -->
        <TextView style="@style/SectHead" android:text="TODAY" />

        <LinearLayout style="@style/SectCard">

            <LinearLayout style="@style/DRow">
                <TextView style="@style/DLabel" android:text="Punch in" />
                <TextView android:id="@+id/tvSetPin" style="@style/DValue" android:text="--:--" />
            </LinearLayout>

            <LinearLayout style="@style/DRow">
                <TextView style="@style/DLabel" android:text="Punch out" />
                <TextView android:id="@+id/tvSetPout" style="@style/DValue" android:text="--:--" />
            </LinearLayout>

            <LinearLayout style="@style/DRow">
                <TextView style="@style/DLabel" android:text="Active Hours" />
                <TextView android:id="@+id/tvSetActive" style="@style/DValue" android:text="00:00:00" />
            </LinearLayout>

            <LinearLayout style="@style/DRow">
                <TextView style="@style/DLabel" android:text="Break used" />
                <TextView android:id="@+id/tvSetBreak" style="@style/DValue" android:text="00:00:00" />
            </LinearLayout>

            <LinearLayout android:id="@+id/rowResetBreak" style="@style/DRow" android:background="?android:attr/selectableItemBackground">
                <TextView style="@style/DLabel" android:text="Reset break counter" android:textColor="#FF9A9A" />
            </LinearLayout>
        </LinearLayout>

        <!-- REMINDERS -->
        <TextView style="@style/SectHead" android:text="REMINDERS" />

        <LinearLayout style="@style/SectCard">

            <LinearLayout style="@style/DRow">
                <TextView style="@style/DLabel" android:text="Reminder" />
                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchEnabled"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout style="@style/DRow">
                <TextView style="@style/DLabel" android:text="Punch-out deadline" />
                <Button android:id="@+id/btnDeadlineMinus" style="@style/DStep" android:text="−" />
                <TextView
                    android:id="@+id/tvDeadline"
                    style="@style/DValue"
                    android:background="?android:attr/selectableItemBackground"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:text="6:00 PM" />
                <Button android:id="@+id/btnDeadlinePlus" style="@style/DStep" android:text="+" />
            </LinearLayout>

            <LinearLayout style="@style/DRow">
                <TextView style="@style/DLabel" android:text="Nag again" />
                <Button android:id="@+id/btnRepeatMinus" style="@style/DStep" android:text="−" />
                <TextView
                    android:id="@+id/tvRepeat"
                    style="@style/DValue"
                    android:background="?android:attr/selectableItemBackground"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:text="2m" />
                <Button android:id="@+id/btnRepeatPlus" style="@style/DStep" android:text="+" />
            </LinearLayout>

            <LinearLayout style="@style/DRow">
                <TextView style="@style/DLabel" android:text="Break limit" />
                <Button android:id="@+id/btnBreakMinus" style="@style/DStep" android:text="−" />
                <TextView
                    android:id="@+id/tvBreakLimit"
                    style="@style/DValue"
                    android:background="?android:attr/selectableItemBackground"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:text="45m" />
                <Button android:id="@+id/btnBreakPlus" style="@style/DStep" android:text="+" />
            </LinearLayout>

            <LinearLayout style="@style/DRow">
                <TextView style="@style/DLabel" android:text="Time format" />

                <Button
                    android:id="@+id/btn12"
                    style="@style/DFmt"
                    android:text="12h" />

                <Button
                    android:id="@+id/btn24"
                    style="@style/DFmt"
                    android:text="24h" />
            </LinearLayout>
        </LinearLayout>

        <!-- ACCESS -->
        <TextView style="@style/SectHead" android:text="ACCESS" />

        <LinearLayout style="@style/SectCard">

            <LinearLayout android:id="@+id/rowA11y" style="@style/DRow" android:background="?android:attr/selectableItemBackground">
                <TextView style="@style/DLabel" android:text="Accessibility" />
                <TextView android:id="@+id/tvA11y" style="@style/DValue" android:text="off" />
            </LinearLayout>

            <LinearLayout android:id="@+id/rowNotif" style="@style/DRow" android:background="?android:attr/selectableItemBackground">
                <TextView style="@style/DLabel" android:text="Notifications" />
                <TextView android:id="@+id/tvNotif" style="@style/DValue" android:text="off" />
            </LinearLayout>

            <LinearLayout android:id="@+id/rowExact" style="@style/DRow" android:background="?android:attr/selectableItemBackground">
                <TextView style="@style/DLabel" android:text="Exact alarms" />
                <TextView android:id="@+id/tvExact" style="@style/DValue" android:text="off" />
            </LinearLayout>

            <LinearLayout android:id="@+id/rowOverlay" style="@style/DRow" android:background="?android:attr/selectableItemBackground">
                <TextView style="@style/DLabel" android:text="Display over other apps" />
                <TextView android:id="@+id/tvOverlay" style="@style/DValue" android:text="off" />
            </LinearLayout>
        </LinearLayout>

        <!-- ACCOUNT -->
        <TextView style="@style/SectHead" android:text="ACCOUNT" />

        <LinearLayout style="@style/SectCard">

            <LinearLayout style="@style/DRow">
                <TextView style="@style/DLabel" android:text="Employee ID" />
                <TextView android:id="@+id/tvEmpId" style="@style/DValue" android:text="not saved" />
            </LinearLayout>

            <LinearLayout android:id="@+id/rowClear" style="@style/DRow" android:background="?android:attr/selectableItemBackground">
                <TextView style="@style/DLabel" android:text="Clear saved details" android:textColor="#FF9A9A" />
            </LinearLayout>
        </LinearLayout>

        <!-- DEVELOPER -->
        <TextView style="@style/SectHead" android:text="DEVELOPER" />

        <LinearLayout style="@style/SectCard">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:contentDescription="Prateek"
                    android:src="@drawable/developer" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="11dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Prateek"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:fontFamily="monospace"
                        android:text="@imprateekd"
                        android:textColor="#8FA6C8"
                        android:textSize="9sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/btnInstagram"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_icon_button"
                    android:contentDescription="Instagram"
                    android:padding="8dp"
                    android:src="@drawable/ic_instagram" />

                <ImageView
                    android:id="@+id/btnWhatsapp"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_marginStart="7dp"
                    android:background="@drawable/bg_icon_button"
                    android:contentDescription="WhatsApp"
                    android:padding="8dp"
                    android:src="@drawable/ic_whatsapp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="TTBS-HRMS 3.4 · by Prateek"
            android:textColor="#3F5673"
            android:textSize="10sp" />
    </LinearLayout>
</ScrollView>
